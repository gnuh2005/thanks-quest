NODE_ENV=development
PORT=4000
# Danh sách origin frontend được phép, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
# Bắt buộc. Ví dụ Atlas: mongodb+srv://user:pass@cluster.mongodb.net/thanksquest
MONGODB_URI=
# Bắt buộc ở production: chuỗi ngẫu nhiên >= 32 ký tự, khác nhau. Sinh: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# AI (tùy chọn). Chỉ đặt ở backend. Để trống = chế độ mẫu, vẫn dùng được.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Chế độ chơi thử
GUEST_TTL_HOURS=24
GUEST_XP_CAP=800
# Tự nạp dữ liệu mẫu khi DB trống
AUTO_SEED=true
TZ_OFFSET_HOURS=7
# Chỉ đặt true khi frontend và backend khác site (cần HTTPS). Khuyến nghị dùng rewrite /api của Vercel thay vì bật cờ này.
# COOKIE_CROSS_SITE=true
# Chỉ dùng cho script create-admin (không có mật khẩu mặc định)
ADMIN_EMAIL=
ADMIN_PASSWORD=
